# ---------------------------------------------------------------------------
# HackerRank Orchestrate — Environment Configuration
# Copy this file to .env and fill in the values. Never commit .env.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# LLM ROUTING
# LLM_MODEL uses LiteLLM naming: "provider/model-name"
# Switch providers by changing this one line and setting the matching key.
#
# Examples:
#   anthropic/claude-haiku-3-5          -> set ANTHROPIC_API_KEY
#   anthropic/claude-opus-4-5           -> set ANTHROPIC_API_KEY
#   openai/gpt-4o                       -> set OPENAI_API_KEY
#   openai/gpt-4o-mini                  -> set OPENAI_API_KEY
#   groq/llama-3.3-70b-versatile        -> set GROQ_API_KEY
#   groq/mixtral-8x7b-32768             -> set GROQ_API_KEY
#   gemini/gemini-1.5-flash             -> set GEMINI_API_KEY
#   gemini/gemini-2.0-flash             -> set GEMINI_API_KEY
#   together_ai/mistralai/Mistral-7B    -> set TOGETHERAI_API_KEY
#   cohere/command-r-plus               -> set COHERE_API_KEY
# ---------------------------------------------------------------------------

LLM_MODEL=anthropic/claude-haiku-3-5

# Max output tokens for each LLM call.
LLM_MAX_TOKENS=1024

# Sampling temperature. 0.0 = deterministic, recommended for triage.
LLM_TEMPERATURE=0.0


# ---------------------------------------------------------------------------
# API KEYS — set only the key that matches LLM_MODEL above.
# LiteLLM reads these directly from the environment; no extra config needed.
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=

OPENAI_API_KEY=

GROQ_API_KEY=

GEMINI_API_KEY=

TOGETHERAI_API_KEY=

COHERE_API_KEY=

# Custom base URL - only needed for local Ollama.
# All hosted providers (OpenRouter, Anthropic, OpenAI, Groq, Gemini, etc.)
# are resolved automatically; leave this blank unless running Ollama locally.
# LLM_API_BASE=http://localhost:11434


# ---------------------------------------------------------------------------
# RETRIEVAL TUNING (optional — defaults are sensible)
# ---------------------------------------------------------------------------

# Minimum merged BM25+vector score to pass a chunk to Stage 3.
# Below this threshold the ticket is escalated instead of going to the LLM.
# Range: 0.0 - 1.0  (default: 0.30)
# RETRIEVAL_THRESHOLD=0.30

# How many top chunks to pass into the LLM context window.
# RETRIEVAL_TOP_K=5
